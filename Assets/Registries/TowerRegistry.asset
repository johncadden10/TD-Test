        modifierPrefab: {fileID: 5066518819745044181, guid: 85695eb72718b4d46bc6df3983c5bd01, type: 3}
        icon: {fileID: 0}
      - upgradeId: reaper_2_2
        displayName: Coworkers
        description: Souls increase in value the longer they are jarred for.
