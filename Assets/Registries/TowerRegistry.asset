        cost: 175
        ectoCost: 300
        modifierPrefab: {fileID: 5066518819745044181, guid: 392fdf2b7b443674da57b2ffc5baf4d9, type: 3}
        icon: {fileID: 0}
      - upgradeId: reaper_1_2
        displayName: Explosive Souls
        description: Vengeful souls deal more damage and explode on contact.
