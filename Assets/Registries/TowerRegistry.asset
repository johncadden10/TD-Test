        ectoCost: 500
        modifierPrefab: {fileID: 5066518819745044181, guid: 361097da8bd78db409a37a6008006de3, type: 3}
        icon: {fileID: 0}
      - upgradeId: reaper_2_3
        displayName: Older and Wiser
        description: Souls increase in value the longer the reaper is alive.
