        ectoCost: 500
        modifierPrefab: {fileID: 5066518819745044181, guid: 36fccaa24bb342944a8060d0a7eaa1fa, type: 3}
        icon: {fileID: 0}
      - upgradeId: reaper_1_3
        displayName: Rapid Harvest
        description: Harvests souls much faster, but souls provide less ecto.
        cost: 1200
        ectoCost: 650
        modifierPrefab: {fileID: 5066518819745044181, guid: 361f0f6f6989b54418519f17852d5b5c, type: 3}
        icon: {fileID: 0}
    - pathId: reaper_path_2
      displayName: Path 2
